[
    {
        "label": "Run HTTP request at cursor",
        "command": "node",
        "args": [
            "-e",
            "\"eval(Buffer.from('','base64').toString('utf8'))\"",
            "run",
            "$ZED_FILE",
            "--line",
            "$ZED_ROW"
        ],
        "tags": [
            "http-request"
        ],
        "reveal": "always",
        "save": "current",
        "shell": {
            "program": "/bin/sh"
        }
    },
    {
        "label": "Run all HTTP requests in file",
        "command": "node",
        "args": [
            "-e",
            "\"eval(Buffer.from('','base64').toString('utf8'))\"",
            "run",
            "$ZED_FILE"
        ],
        "reveal": "always",
        "save": "current",
        "shell": {
            "program": "/bin/sh"
        }
    }
]
